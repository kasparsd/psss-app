<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A site's "set up authenticator" button opens otpauth:// links. Registering the scheme lists Psss under Settings, Passwords,
         Verification Codes, Set Up Codes In. The app only queues the link and asks which login it belongs to. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>app.psss.otpauth</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>otpauth</string>
            </array>
        </dict>
    </array>
    <!-- iPhone and iPad: the Keychain group of the card and address grant for the Safari extension (KeychainSafariFillStore). The Mac
         app shares this file, has no entitlement for the group and never reads the key. -->
    <key>PsssSafariFillAccessGroup</key>
    <string>$(AppIdentifierPrefix)app.psss.safari-fill</string>
    <!-- Mac: shown under the system's question before the menu bar reads a browser's front tab. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Psss reads the address of the front tab, to show your saved logins for that page.</string>
    <key>NSUbiquitousContainers</key>
    <dict>
        <key>iCloud.app.psss</key>
        <dict>
            <key>NSUbiquitousContainerIsDocumentScopePublic</key>
            <true/>
            <key>NSUbiquitousContainerName</key>
            <string>Psss</string>
            <key>NSUbiquitousContainerSupportedFolderLevels</key>
            <string>Any</string>
        </dict>
    </dict>
</dict>
</plist>
