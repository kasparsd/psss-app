<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Psss</string>
    <!-- iPhone and iPad: the Keychain group of the vault keys (BiometricKey). The Mac provider keeps them in its App Group and
         never reads the key. -->
    <key>PsssVaultKeyAccessGroup</key>
    <string>$(AppIdentifierPrefix)app.psss.vault-key</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Psss uses Face ID to unlock your passwords before it signs you in.</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>ASCredentialProviderExtensionCapabilities</key>
            <dict>
                <key>ProvidesPasswords</key>
                <true/>
                <key>ProvidesPasskeys</key>
                <true/>
                <key>ProvidesOneTimeCodes</key>
                <true/>
                <!-- iOS 18 and later: the person taps any field and chooses Psss to insert one value (frame 14 on fill-a-login.html). -->
                <key>ProvidesTextToInsert</key>
                <true/>
                <key>SupportsSavePasswordCredentials</key>
                <true/>
                <key>SupportsGeneratePasswordCredentials</key>
                <true/>
                <!-- Psss has no sheet for a person-started generate request yet, so the system shows its own experience. The
                     key defaults to true, which is why it is spelled out as false. Remove it when the sheet exists
                     (docs/plans/password-generator.md, package 3). -->
                <key>SupportsGeneratePasswordCredentialsWithUI</key>
                <false/>
            </dict>
        </dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.authentication-services-credential-provider-ui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
    </dict>
</dict>
</plist>
