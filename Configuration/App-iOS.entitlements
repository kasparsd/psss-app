<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <true/>
    <key>com.apple.developer.networking.HotspotConfiguration</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.psss</string>
    </array>
    <!-- The first group is where a Keychain item saved without naming a group goes, so the app's own stays first. The second
         holds only the card and address grant for the Safari extension (KeychainSafariFillStore). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)app.psss.Psss</string>
        <string>$(AppIdentifierPrefix)app.psss.safari-fill</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.app.psss</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
        <string>CloudDocuments</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.app.psss</string>
    </array>
</dict>
</plist>
