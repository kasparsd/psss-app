{
  "manifest_version": 3,
  "name": "Psss",
  "short_name": "Psss",
  "version": "0.1.0",
  "description": "Fill sign-in details from your Psss vault. Everything stays on your device.",
  "icons": {
    "16": "action-16.png",
    "32": "action-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Fill with Psss",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "action-16.png",
      "32": "action-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Fill with Psss"
    }
  }
}
