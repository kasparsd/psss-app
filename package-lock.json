{
  "name": "psss",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "psss",
      "version": "0.0.0",
      "workspaces": [
        "Packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@psss/cli": {
      "resolved": "Packages/cli",
      "link": true
    },
    "node_modules/@psss/cli-agent-prototype": {
      "resolved": "Packages/cli-agent-prototype",
      "link": true
    },
    "node_modules/@psss/format": {
      "resolved": "Packages/format",
      "link": true
    },
    "node_modules/@psss/kdbx": {
      "resolved": "Packages/kdbx",
      "link": true
    },
    "node_modules/@psss/test-sites": {
      "resolved": "Packages/test-sites",
      "link": true
    },
    "node_modules/@psss/vault": {
      "resolved": "Packages/vault",
      "link": true
    },
    "Packages/cli": {
      "name": "@psss/cli",
      "version": "0.0.0",
      "bin": {
        "psss": "src/bin/psss.ts"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "Packages/cli-agent-prototype": {
      "name": "@psss/cli-agent-prototype",
      "version": "0.0.0",
      "bin": {
        "psss": "src/cli.ts"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "Packages/format": {
      "name": "@psss/format",
      "version": "0.0.0",
      "engines": {
        "node": ">=24"
      }
    },
    "Packages/kdbx": {
      "name": "@psss/kdbx",
      "version": "0.0.0",
      "engines": {
        "node": ">=24"
      }
    },
    "Packages/test-sites": {
      "name": "@psss/test-sites",
      "version": "0.0.0",
      "engines": {
        "node": ">=24"
      }
    },
    "Packages/vault": {
      "name": "@psss/vault",
      "version": "0.0.0",
      "engines": {
        "node": ">=24"
      }
    }
  }
}
