{
  "description": "Deterministic CBOR (section 2).",
  "vectors": [
    {
      "name": "cbor/encode/uint-0",
      "description": "Unsigned integer 0 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "0"
        }
      },
      "expected": {
        "hex": "00"
      }
    },
    {
      "name": "cbor/encode/uint-23",
      "description": "Unsigned integer 23 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "23"
        }
      },
      "expected": {
        "hex": "17"
      }
    },
    {
      "name": "cbor/encode/uint-24",
      "description": "Unsigned integer 24 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "24"
        }
      },
      "expected": {
        "hex": "1818"
      }
    },
    {
      "name": "cbor/encode/uint-255",
      "description": "Unsigned integer 255 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "255"
        }
      },
      "expected": {
        "hex": "18ff"
      }
    },
    {
      "name": "cbor/encode/uint-256",
      "description": "Unsigned integer 256 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "256"
        }
      },
      "expected": {
        "hex": "190100"
      }
    },
    {
      "name": "cbor/encode/uint-65535",
      "description": "Unsigned integer 65535 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "65535"
        }
      },
      "expected": {
        "hex": "19ffff"
      }
    },
    {
      "name": "cbor/encode/uint-65536",
      "description": "Unsigned integer 65536 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "65536"
        }
      },
      "expected": {
        "hex": "1a00010000"
      }
    },
    {
      "name": "cbor/encode/uint-4294967295",
      "description": "Unsigned integer 4294967295 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "4294967295"
        }
      },
      "expected": {
        "hex": "1affffffff"
      }
    },
    {
      "name": "cbor/encode/uint-4294967296",
      "description": "Unsigned integer 4294967296 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "4294967296"
        }
      },
      "expected": {
        "hex": "1b0000000100000000"
      }
    },
    {
      "name": "cbor/encode/uint-18446744073709551615",
      "description": "Unsigned integer 18446744073709551615 in its shortest encoding.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "uint": "18446744073709551615"
        }
      },
      "expected": {
        "hex": "1bffffffffffffffff"
      }
    },
    {
      "name": "cbor/encode/text-empty",
      "description": "Empty text string.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "text": ""
        }
      },
      "expected": {
        "hex": "60"
      }
    },
    {
      "name": "cbor/encode/text-ietf",
      "description": "Text string \"IETF\".",
      "type": "cbor.encode",
      "input": {
        "value": {
          "text": "IETF"
        }
      },
      "expected": {
        "hex": "6449455446"
      }
    },
    {
      "name": "cbor/encode/text-nfc-e-acute",
      "description": "U+00E9 (already NFC) is two UTF-8 bytes.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "text": "é"
        }
      },
      "expected": {
        "hex": "62c3a9"
      }
    },
    {
      "name": "cbor/encode/bytes-empty",
