    },
    {
      "name": "cbor/encode/array-123",
      "description": "Array [1,2,3].",
      "type": "cbor.encode",
      "input": {
        "value": {
          "array": [
            {
              "uint": "1"
            },
            {
              "uint": "2"
            },
            {
              "uint": "3"
            }
          ]
        }
      },
      "expected": {
        "hex": "83010203"
      }
    },
    {
      "name": "cbor/encode/array-nested",
      "description": "Nested arrays.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "array": [
            {
              "uint": "1"
            },
            {
              "array": [
                {
                  "uint": "2"
                },
                {
                  "uint": "3"
                }
              ]
            },
            {
              "array": [
                {
                  "uint": "4"
                },
                {
                  "uint": "5"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "hex": "8301820203820405"
      }
    },
    {
      "name": "cbor/encode/false",
      "description": "false.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "bool": false
        }
      },
      "expected": {
        "hex": "f4"
      }
    },
    {
      "name": "cbor/encode/true",
      "description": "true.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "bool": true
        }
      },
      "expected": {
        "hex": "f5"
      }
    },
    {
      "name": "cbor/encode/null",
      "description": "null.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "null": true
        }
      },
      "expected": {
        "hex": "f6"
      }
    },
    {
      "name": "cbor/encode/map-empty",
      "description": "Empty map.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": []
        }
      },
      "expected": {
        "hex": "a0"
      }
    },
    {
      "name": "cbor/encode/map-int-keys-sorted",
      "description": "Integer keys given out of order are sorted by their encodings: 1, 10, 24, 256.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": [
            [
              {
                "uint": "24"
              },
              {
                "uint": "0"
              }
            ],
            [
              {
                "uint": "1"
              },
              {
                "uint": "0"
              }
            ],
            [
              {
                "uint": "256"
              },
              {
                "uint": "0"
              }
            ],
            [
              {
                "uint": "10"
              },
              {
                "uint": "0"
              }
            ]
          ]
        }
      },
      "expected": {
        "hex": "a401000a0018180019010000"
      }
    },
    {
      "name": "cbor/encode/map-text-keys-length-first",
      "description": "Text keys sort by their encoding, so \"b\" comes before \"aa\" (shorter first).",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": [
            [
              {
                "text": "aa"
              },
              {
                "uint": "2"
              }
            ],
            [
              {
                "text": "b"
              },
              {
                "uint": "1"
              }
            ]
          ]
        }
      },
      "expected": {
        "hex": "a261620162616102"
      }
    },
    {
      "name": "cbor/encode/map-text-keys-upper-before-lower",
      "description": "Same length: bytewise, so \"B\" (0x42) before \"a\" (0x61).",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": [
            [
              {
                "text": "a"
              },
              {
                "uint": "1"
              }
            ],
            [
              {
                "text": "B"
              },
              {
                "uint": "2"
              }
            ]
          ]
        }
      },
      "expected": {
        "hex": "a2614202616101"
      }
    },
    {
      "name": "cbor/encode/map-text-keys-multibyte",
      "description": "Encoded length counts UTF-8 bytes: \"z\" (1 byte) before U+00E9 (2 bytes).",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": [
            [
              {
                "text": "é"
              },
              {
                "uint": "1"
              }
            ],
            [
              {
                "text": "z"
              },
              {
                "uint": "2"
              }
            ]
          ]
        }
      },
      "expected": {
        "hex": "a2617a0262c3a901"
      }
    },
    {
      "name": "cbor/encode/map-nested",
      "description": "Map inside a map value.",
      "type": "cbor.encode",
      "input": {
        "value": {
          "map": [
            [
              {
                "uint": "1"
              },
              {
                "map": [
                  [
                    {
                      "text": "k"
                    },
                    {
                      "bytes": "ff"
                    }
                  ]
                ]
              }
            ]
          ]
        }
      },
      "expected": {
        "hex": "a101a1616b41ff"
      }
    },
    {
