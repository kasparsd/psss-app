---
// The head every page shares. The pages differ in their words and in whether search engines may list them.
import font from '../assets/VarelaRound-Regular.woff2?url';
import favicon from '../assets/Psss-mark-small.svg?url';
import favicon32 from '../assets/favicon-32.png?url';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFF9E5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1F23" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" href={font} crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
