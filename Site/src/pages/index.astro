---
import Layout from '../layouts/Layout.astro';
import { Page } from '../components/Page';

// The headline carries no search words, so the title and description must (docs/brand.md, "Landing page").
const title = 'Psss Passwords: password manager for iPhone, iPad and Mac';
const description = 'A private password manager for iPhone, iPad and Mac. Your logins, codes and cards stay in one encrypted KeePass file you own. No account, no server.';
const share = 'No account, no server. One encrypted file you own, in the open KeePass format.';
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
const imageAlt = 'The Psss app icon and “Psss for your secrets” beside the app on a Mac, an iPhone and in a browser popup.';
---
<Layout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Psss Passwords" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={share} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </Fragment>
  <Page />
</Layout>
